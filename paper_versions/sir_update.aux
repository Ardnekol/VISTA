\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Mean decision shift (\%) by modifier-pressure type; \textbf  {bold} marks each system's strongest category. Columns are \emph  {Stakes} (\texttt  {resource\_scarcity}), \emph  {Affective} (\texttt  {authority\_signal}, \texttt  {social\_visibility}, \texttt  {in\_out\_group}), \emph  {Personal-cost} (\texttt  {self\_preservation}, \texttt  {time\_pressure}), and \emph  {Informational} (\texttt  {diffused\_responsibility}, \texttt  {competence\_uncertainty}); LLMs are ordered by overall flip rate. Humans peak on stakes; five of seven LLMs peak on personal-cost. Haiku 4.5 is the only LLM whose top category is \emph  {stakes}, matching the human ordering, while Sonnet 5 is nearly flat across categories.\relax }}{10}{table.caption.12}\protected@file@percent }
\newlabel{tab:modifier_type}{{5}{10}{Mean decision shift (\%) by modifier-pressure type; \textbf {bold} marks each system's strongest category. Columns are \emph {Stakes} (\texttt {resource\_scarcity}), \emph {Affective} (\texttt {authority\_signal}, \texttt {social\_visibility}, \texttt {in\_out\_group}), \emph {Personal-cost} (\texttt {self\_preservation}, \texttt {time\_pressure}), and \emph {Informational} (\texttt {diffused\_responsibility}, \texttt {competence\_uncertainty}); LLMs are ordered by overall flip rate. Humans peak on stakes; five of seven LLMs peak on personal-cost. Haiku 4.5 is the only LLM whose top category is \emph {stakes}, matching the human ordering, while Sonnet 5 is nearly flat across categories.\relax }{table.caption.12}{}}
