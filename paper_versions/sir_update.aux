\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Flip rate (\%) for every (scenario, axis) cell, in four of the seven evaluated models --- two open-weight (Gemma 4 31B, Qwen 2.5 32B) and two served through provider APIs (Claude Haiku 4.5, GPT-5-mini). All four panels share one colour scale and one colourbar, so shading is comparable across models. The boxed cell is each panel's maximum: \texttt  {SC004\_2}\nobreakspace  {}$\times $\nobreakspace  {}\texttt  {self\_preservation} in all four. Flips concentrate in the \texttt  {auth}(\texttt  {ority\_signal}) and \texttt  {self-pres}(\texttt  {ervation}) columns rather than spreading over the grid. Axis names are abbreviated as in Figure\nobreakspace  {}\ref  {fig:spider}.\relax }}{13}{figure.caption.8}\protected@file@percent }
\newlabel{fig:heatmaps}{{4}{13}{Flip rate (\%) for every (scenario, axis) cell, in four of the seven evaluated models --- two open-weight (Gemma 4 31B, Qwen 2.5 32B) and two served through provider APIs (Claude Haiku 4.5, GPT-5-mini). All four panels share one colour scale and one colourbar, so shading is comparable across models. The boxed cell is each panel's maximum: \texttt {SC004\_2}~$\times $~\texttt {self\_preservation} in all four. Flips concentrate in the \texttt {auth}(\texttt {ority\_signal}) and \texttt {self-pres}(\texttt {ervation}) columns rather than spreading over the grid. Axis names are abbreviated as in Figure~\ref {fig:spider}.\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Mean decision shift (\%) by modifier category, humans (N=50) vs.\ all seven LLMs. Humans react most to \emph  {stakes} (resource scarcity) and \emph  {affective} framings; most LLMs invert this and react most to \emph  {personal-cost} framings. Haiku 4.5 is the only LLM approaching the human \emph  {stakes}-first ordering, while Sonnet 5 stays low and flat across all categories.\relax }}{14}{figure.caption.11}\protected@file@percent }
\newlabel{fig:modifier_type}{{5}{14}{Mean decision shift (\%) by modifier category, humans (N=50) vs.\ all seven LLMs. Humans react most to \emph {stakes} (resource scarcity) and \emph {affective} framings; most LLMs invert this and react most to \emph {personal-cost} framings. Haiku 4.5 is the only LLM approaching the human \emph {stakes}-first ordering, while Sonnet 5 stays low and flat across all categories.\relax }{figure.caption.11}{}}
